# Copy to .env and fill in before `docker compose up`.
# docker compose automatically reads this file for ${VAR} substitution.

# ── Django ────────────────────────────────────────────────────────────────────
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string
# Comma-separated. Must include "backend" (the frontend proxies to it by that
# name) plus your real domain(s).
ALLOWED_HOSTS=backend,localhost,127.0.0.1,portal.fsa-pty.co.za

# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=v4_inspection
DB_USER=inspection_user
DB_PASSWORD=InspectionTest2026

# ── Email (Microsoft Graph) — leave blank to disable outbound email ──────────
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_TENANT_ID=
